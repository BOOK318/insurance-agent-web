# Docker image built by GitHub Actions.
# Example: ghcr.io/your-github-org/insurance-agent-web:latest
APP_IMAGE=ghcr.io/your-github-org/insurance-agent-web:latest

# Database inside Docker. Use a different strong password per team.
# Use URL-safe hex, e.g. `openssl rand -hex 24`; avoid "/" or "=".
DB_PASSWORD=change_this_hex_password

# JWT signing secret. Use a random 32+ character value per team.
JWT_SECRET=change_this_to_random_32char_string

# Claude / Anthropic key. Can also be overridden later in /admin/settings.
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Cloudflare named tunnel token and domain for this team.
CLOUDFLARE_TUNNEL_TOKEN=eyJhbGci...
TUNNEL_DOMAIN=team-a.yourcompany.com

# Optional ports.
APP_PORT=3000
DB_PORT=5432

# Ollama runs on the Mac mini host, outside Docker.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Optional local Whisper voice transcription. Runs on the Mac mini host.
WHISPER_URL=http://host.docker.internal:9000/inference
TRANSCRIBE_MAX_BYTES=26214400

# If the GHCR package is private, create a read-only GitHub token
# with read:packages and put it here for watchtower auto-updates.
GHCR_USER=your_github_username
GHCR_READ_TOKEN=
WATCHTOWER_POLL_INTERVAL=3600

# Web Push (VAPID). Generate once with:
#   docker run --rm node:20-alpine sh -c "npx -y web-push generate-vapid-keys --json"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@team.local

# Backups
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_NOTIFY_URL=
TZ=Asia/Hong_Kong

# Sentry (optional). Leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
