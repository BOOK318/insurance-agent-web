# Local dev environment for `npm run dev`
# Copy to `.env.local` and fill in real values.

# Postgres connection — must point at your local Postgres instance
DATABASE_URL=postgres://postgres:postgres@localhost:5432/insurance

# JWT signing secret — any random ≥32-char string
JWT_SECRET=replace_with_a_random_string_at_least_32_chars_long

# Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional local Whisper voice transcription server.
# Dev uses localhost because Next.js runs directly on this machine.
WHISPER_URL=http://127.0.0.1:9000/inference
TRANSCRIBE_MAX_BYTES=26214400
