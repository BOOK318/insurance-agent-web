# 資料庫密碼（自己設，要夠長）
DB_PASSWORD=change_this_strong_password

# JWT加密密鑰（隨機字串，最少32個字）
JWT_SECRET=change_this_to_random_32char_string

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Cloudflare Tunnel Token（從Cloudflare Dashboard攞）
CLOUDFLARE_TUNNEL_TOKEN=eyJhbGci...

# 你嘅domain（例如 team-a.yourcompany.com）
TUNNEL_DOMAIN=team-a.yourcompany.com

# GitHub用戶名（用嚟拉Docker image）
GITHUB_USER=your_github_username

# 本地 Whisper 語音轉文字（可選）
WHISPER_URL=http://host.docker.internal:9000/inference
TRANSCRIBE_MAX_BYTES=26214400
